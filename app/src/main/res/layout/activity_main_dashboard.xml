<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:elevation="8dp"
        android:background="#0F172A">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="#1E293B"
            app:expandedTitleMarginStart="28dp"
            app:expandedTitleMarginBottom="32dp"
            app:collapsedTitleTextColor="#FFFFFF"
            app:expandedTitleTextColor="#FFFFFF"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:title="GuideFlow SDK">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin" />
                
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Discover Capabilities"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#102A43"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Tap any module below to see how GuideFlow seamlessly highlights views across different Android architectures."
                android:textColor="#486581"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="32dp" />

            <!-- Card 1: Activity -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActivityDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity &amp; Views"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#102A43"
                        android:layout_marginBottom="6dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toolbars, floating buttons, dynamic positioning, and theme switching."
                        android:textColor="#627D98"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Launch Demo →"
                        android:textColor="#3B82F6"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Fragment -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFragmentDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fragment Support"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#102A43"
                        android:layout_marginBottom="6dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See how overlays respect Fragment bounds without bleeding outside the container."
                        android:textColor="#627D98"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Launch Demo →"
                        android:textColor="#10B981"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Scroll Target -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardListDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Scroll Targeting"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#102A43"
                        android:layout_marginBottom="6dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Watch GuideFlow automatically scroll deep into a list to find its target view."
                        android:textColor="#627D98"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Launch Demo →"
                        android:textColor="#F59E0B"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Dialog -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDialogDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BottomSheet Dialogs"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#102A43"
                        android:layout_marginBottom="6dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Onboard users properly within BottomSheets without z-index collisions."
                        android:textColor="#627D98"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Launch Demo →"
                        android:textColor="#8B5CF6"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Spotlight Shapes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSpotlightDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spotlight Shapes Demo"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#102A43"
                        android:layout_marginBottom="6dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visualize all supported spotlight shapes: Circle, Rectangle, Rounded Rect, and Oval."
                        android:textColor="#627D98"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Launch Demo →"
                        android:textColor="#EC4899"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 6: Error Handling -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardErrorDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crash-Proof Design"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#102A43"
                        android:layout_marginBottom="6dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prove that the SDK will not crash even when targeting missing, GONE, or detached views."
                        android:textColor="#627D98"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Launch Demo →"
                        android:textColor="#EF4444"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 7: Navigation Demo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNavigationDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multi-Screen Navigation"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#102A43"
                        android:layout_marginBottom="6dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chain multiple GuideFlow tours together across different fragments seamlessly."
                        android:textColor="#627D98"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Launch Demo →"
                        android:textColor="#10B981"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer: Creator Info & GitHub Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Built with ❤️ by Raj Javiya"
                    android:textColor="#64748B"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"/>
                    
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGithub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#E2E8F0"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View on GitHub ↗"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
