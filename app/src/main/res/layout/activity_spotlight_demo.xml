<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <include layout="@layout/layout_standard_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spotlight Shapes"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#102A43"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/viewCircle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardBackgroundColor="#10B981"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="32dp"
                android:layout_gravity="center">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Circle"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/viewRectangle"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                app:cardBackgroundColor="#F59E0B"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="32dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Rectangle"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/viewRounded"
                android:layout_width="200dp"
                android:layout_height="100dp"
                app:cardBackgroundColor="#8B5CF6"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Rounded Rect"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/viewOval"
                android:layout_width="160dp"
                android:layout_height="80dp"
                app:cardBackgroundColor="#EF4444"
                app:cardCornerRadius="80dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:layout_gravity="end"
                android:layout_marginBottom="48dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Oval"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap any shape above to see its corresponding Spotlight in action!"
                android:textColor="#627D98"
                android:textSize="16sp"
                android:textAlignment="center"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"/>
                
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
