<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <include layout="@layout/layout_standard_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Custom Injection"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#102A43"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Choose how you want to inject custom UI components into the GuideFlow tooltip engine."
                android:textColor="#486581"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="32dp" />

            <!-- Card 1: Step Custom Content -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCustomContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step-Level XML Injection"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#102A43"
                        android:layout_marginBottom="6dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inject an XML layout directly inside the default SDK tooltip bubble. Keeps arrows and buttons."
                        android:textColor="#627D98"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show Demo →"
                        android:textColor="#3B82F6"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Fully Custom Provider -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFullCustomProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fully Custom Provider"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#102A43"
                        android:layout_marginBottom="6dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bypass the SDK's tooltip entirely. Provide a view factory to draw your strict design system UIs from scratch."
                        android:textColor="#627D98"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show Demo →"
                        android:textColor="#E91E63"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
